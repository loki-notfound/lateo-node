# Copy to .env next to compose.yaml and fill in. Never commit .env.
# The token is shown in the Cloudflare dashboard when you create the tunnel
# (Zero Trust > Networks > Tunnels > your tunnel > Install connector).
TUNNEL_TOKEN=

# Optional: the host address RPC (port 17767) is published on, beside the
# tunnel. By default that is every address of the host (0.0.0.0), reachable
# without Cloudflare in front. 127.0.0.1 keeps it to the host itself, so the
# tunnel is the only way in.
# RPC_BIND=127.0.0.1

# Optional: the same for the P2P port 17766, on which other Zephyr nodes connect
# in. 127.0.0.1 closes it; the node then makes outgoing connections only.
# P2P_BIND=127.0.0.1

# Optional: the image of the official release instead of myzephyr.
# ZEPHYR_IMAGE=ghcr.io/loki-notfound/zephyr:v2.3.0
